MONGODB_URI=
PORT=
# Min 32 chars in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Access token lifetime: 900, 15m, 1h...
JWT_EXPIRES_IN=15m
# Comma-separated list of allowed origins, e.g.
#   https://technoastuce.com,https://admin.technoastuce.com
# Required in production; when empty in development any origin is allowed.
CORS_ORIGIN=
NODE_ENV=
DB_NAME=
LOG_LEVEL=
# Set to true behind a reverse proxy (nginx, Render, Railway...) so the real
# client IP is used for rate limiting and session info.
TRUST_PROXY=false
# Swagger UI at /api/v1/docs. Defaults to true, except in production.
SWAGGER_ENABLED=
# Public base URL of this API (links in emails, e.g. one-click unsubscribe).
# Defaults to http://localhost:PORT.
API_PUBLIC_URL=

# Auth
APP_NAME=Technoastuce
# Frontend base URL used in email links (/verify-email, /reset-password).
APP_WEB_URL=http://localhost:3000
REFRESH_TOKEN_TTL_DAYS=30
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# 2FA (TOTP) secrets are encrypted at rest with this key: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=

# SMTP. Defaults target Mailpit (UI: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Technoastuce <no-reply@technoastuce.local>"

# Cache. Without REDIS_URL an in-process cache and rate limiter are used
# (fine for a single instance). With several instances, set it so cache
# invalidation and rate limits are shared. rediss:// for TLS.
REDIS_URL=
REDIS_KEY_PREFIX=technoastuce:
CACHE_TTL_SECONDS=60

